     2180 IFC$="1"THENINPUTZI$
     2190 IFC$="2"THENINPUTYI$
     2200 IFC$="3"THENINPUTRI$
     2210 GOTO2050
     2220 PRINTP$;E$:PRINTP$;"PRESS -M- FOR MENU"
     2230 GETC$:IFC$<>""THEN2230
     2240 GETC$:IFC$=""THENGOTO2240
     2250 PRINT"[HOME]":GOTO610
     2460 REM"**** DATASTORAGE AND PROGRAM END ****"
