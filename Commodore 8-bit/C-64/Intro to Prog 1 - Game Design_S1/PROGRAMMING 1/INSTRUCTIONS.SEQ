     2310 GETC$:IFC$<>"L"ANDC$<>"A" THEN2310
     2320 IFC$="L"THENLL=1
     2330 PRINTP1$;E$;P$;"[DOWN]***PRINTINGRECORDS***":OPEN5,4,7
          :PRINT#5:PRINT#5
     2340 PRINT#5:PRINT#5:PRINT#5,"";SPC((40-LEN(ZI$))/2);ZI$
     2350 PRINT#5:PRINT#5:PRINT#5
     2360 CT=0:FORQ=1TOX-1



