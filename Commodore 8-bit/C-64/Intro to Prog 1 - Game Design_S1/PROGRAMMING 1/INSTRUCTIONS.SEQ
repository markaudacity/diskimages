     2080 PRINT"[HOME][11 DOWN] 3.LAST REVISION DATE: ";RI$
     2090 PRINTP$;"CHANGES?(Y/N)"
     2100 GETC$:IFC$=""THEN2100
     2110 IFC$="Y"THEN2140
     2120 IFC$="N"THEN2220 
