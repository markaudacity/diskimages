     1510 IFC$="M"THENGOTO610
     1520 IFC$="P"THEN1540
     1530 GOTO1490
     1540 PP=PP+M:D=PP:IFD>X-1THENGOTO610
     1550 GOTO1290
     1580 PRINTP$;E$:PRINTP$;"PRESS -C- TO CONTINUE"
