     2370 GETC$:IFC$="[F1]"THEN2440
     2380 IFC$<>""THEN2370
     2390 I=Q:IFLL=1THENI=T%(Q):IFI=0THEN2440
     2400 PRINTP1$;TAB(24);"#";I:CT=CT+1
     2410 FORJ=1TOL:IFJ=1THENPRINT#5,"";SPC(4-LEN(STR$(I)));I;J;D$
          (I,J):GOTO2430
     2420 PRINT#5,"";SPC(7-LEN(STR$(J)));J;D$(I,J)
     2430 NEXTJ:PRINT#5:PRINT#5:NEXTQ
     2440 PRINT#5:PRINT#5,CT;"RECORDS PRINTED"
     2450 CLOSE5:S=0:GOTO610
